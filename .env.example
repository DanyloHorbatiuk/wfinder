# PostgreSQL (data)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_URL=postgresql+psycopg2://user:password@localhost:5432/dbname

# pgAdmin
PGADMIN_EMAIL=
PGADMIN_PASSWORD=

# MinIO
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_BUCKET_NAME=
MINIO_ENDPOINT=http://localhost:9000

# Джерела даних
CAREERS_URL_EPAM=
CAREERS_URL_SOFTSERVE=

# Telegram
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
# опційно: окремий чат для сповіщень про збої (E-07); якщо порожньо, використовується TELEGRAM_CHAT_ID
TELEGRAM_ALERT_CHAT_ID=

# Airflow
AIRFLOW_SECRET_KEY=
AIRFLOW_JWT_SECRET=

# Metabase
MB_DB_DBNAME=
# опційно, для scripts/metabase_provision.py (E-10)
METABASE_ADMIN_EMAIL=
METABASE_ADMIN_PASSWORD=
METABASE_RO_PASSWORD=

# Сповіщення: true — лише логувати, не надсилати в Telegram
NOTIFY_DRY_RUN=true

# Захист від масового закриття пропозицій (E-06)
GUARD_MIN_RATIO=0.5
GUARD_HISTORY_N=7
GUARD_MIN_HISTORY=3
GUARD_MAX_CLOSE_SHARE=0.5
GUARD_MIN_ACTIVE=10
